  m_Script: {fileID: 11500000, guid: d29874e3b4e59e549ab8ca779e34be5a, type: 3}
  m_Name: Goop_0-Discovers human in Goop Galaxy
  m_EditorClassIdentifier: 
  speakerName: T.I.I.G.E.R
  paragraphs:
  - "What are you doing here? This course was abandoned by the Caddi long before
    their disappearance. Speculation suggests a violent event caused their retreat.\r"
  - "I\u2019m still detecting high concentrations of dark matter surrounding planets
    in this galaxy. Your golf ball will stick to any contaminated planet."
  - "ERROR(path-coursePrediction:NaN:div0)\r"
  - 'Course interference detected. Your success now relies solely on your own initiative.

'
  revealNameLater: 0
