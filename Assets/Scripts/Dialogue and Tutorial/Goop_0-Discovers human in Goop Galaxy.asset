  m_Script: {fileID: 11500000, guid: d29874e3b4e59e549ab8ca779e34be5a, type: 3}
  m_Name: Goop_0-Discovers human in Goop Galaxy
  m_EditorClassIdentifier: 
  speakerName: T.I.I.G.E.R
  paragraphs:
  - 'Why are you here? This course was discontinued by the Caddi long before they
    disappeared. '
  - Their reasoning was a mystery, but it was rumoured that a barbaric alien group
    harnessed the forces of dark matter to banish them.
  - "I\u2019m still detecting high concentrations of dark matters surrounding planets
    in this galaxy. Your golf ball will stick to any contaminated planet."
  - '%ERROR(path-coursePrediction:NaN:div0)'
  - "It\u2019s interfering with my instruments, you\u2019re on your own."
  revealNameLater: 0
  hiddenSpeakerName: 
