  m_Script: {fileID: 11500000, guid: d29874e3b4e59e549ab8ca779e34be5a, type: 3}
  m_Name: Mythical__4-Congratulations
  m_EditorClassIdentifier: 
  speakerName: T.I.I.G.E.R
  paragraphs:
  - "You\u2019ve done it! You\u2019ve completed the Andromeda course!"
  - "Thank you human, for discovering this golf course. I hope to see you revive
    the sport of golfing throughout the multiverse and continue the Caddi\u2019s
    legacy."
  - "I\u2019ve just located the Universe Drive, you can now travel the multiverse
    to continue to play golf until the end of time."
  - "Thank you for playing the golf courses one last time. I\u2019m afraid I will
    have to leave you here. The concentration of u-235 in my backup generator reactor
    core has dipped below critical mass."
  - 'Goodbye.|

    %Initiateshutdown?.invoke(thread)'
