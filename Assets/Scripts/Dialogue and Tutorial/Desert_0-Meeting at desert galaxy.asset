  m_Script: {fileID: 11500000, guid: d29874e3b4e59e549ab8ca779e34be5a, type: 3}
  m_Name: Desert_0-Meeting at desert galaxy
  m_EditorClassIdentifier: 
  speakerName: T.I.I.G.E.R
  paragraphs:
  - "Wow. Despite that terrible anatomy, you\u2019ve actually made it this far. Quite
    impressive really, I had wagered you would give up on the last hole."
  - "Ah, what am I saying, the Milky Way is the easiest course of them all. Let\u2019s
    see you face a real challenge in this galaxy, notorious for its abundance of
    moons."
  - "Careful, one small misstep and you\u2019ll be sent flying off into space."
