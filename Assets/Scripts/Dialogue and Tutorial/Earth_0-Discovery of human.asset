  m_Script: {fileID: 11500000, guid: d29874e3b4e59e549ab8ca779e34be5a, type: 3}
  m_Name: Earth_0-Discovery of human
  m_EditorClassIdentifier: 
  speakerName: T.I.I.G.E.R
  paragraphs:
  - "%Incoming transmission:ACCEPTED|\r\n**start(bootSetup):!!1stackTraceERROR|\r\n(IFNULL)\u2026---|\r\n\rSUCCESS!|\n"
  - "Greetings, Traveler. Welcome to the St. Andromeda Golf Corporation\u2019s premium
    experience in the Milky Way. Prepare to engage in a golfing experience unparalleled
    in the galaxy. "
  - I am the Technological Intelligence for Intergalactic Golfing Environmental Reconnaissance,
    referred to as TIIGER@. Please stand still for biometric analysis.
  - "Wait\u2026 this is unexpected. You do not appear to be of the genus Caddix.\r"
  - "A human? How\u2026 quaint. With your inefficient biology: two hands, two eyes,
    two legs. This may be problematic."
  - I have been maintaining this golf course for over a billion years, awaiting my
    creators' return. Instead, I receive you, a mere alien?
  - You claim to be a skilled golfer? Prove it. Complete this hole, and we may proceed.
  revealNameLater: 1
  hiddenSpeakerName: ???
