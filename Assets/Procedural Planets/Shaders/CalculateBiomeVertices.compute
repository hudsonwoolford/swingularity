// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel CSMain
#include "Includes/FractalNoise.cginc"

float rand(float2 co)
{
    return(frac(sin(dot(co.xy, float2(12.9898, 78.233))) * 43758.5453)) * 1;
}

StructuredBuffer<float3> planetVertices;

AppendStructuredBuffer<float3> biomeAVertices;
AppendStructuredBuffer<float3> biomeBVertices;
AppendStructuredBuffer<float3> biomePVertices;

uint _NumVertices;
float _SeaLevel;
float3 _PlanetCenter;

int _Octaves;
float3 _Offset;
float _Scale, _Persistence, _Lacunarity, _Multiplier, _Gain;

int _WarpOctaves;
float3 _WarpOffset;
float _WarpScale, _WarpPersistence, _WarpLacunarity, _WarpMultiplier, _WarpGain;

float _BiomeA;
float _BiomeB;
float _BiomeAEnd;
float _BiomeBStart;
float _SwapBiome;

float _BiomeAVegetationLine;
float _BiomeBVegetationLine;

float _PolarHeight;
float _PolarBlendIntensity;
float _Polar;
float _BiomePVegetationLine;


[numthreads(512,1,1)]
void CSMain (uint id : SV_DispatchThreadID)
{
    if(id >= _NumVertices) {return;} //No out of range calculations
    if((planetVertices[id] + _PlanetCenter).z > -0.3) {return;}

    float3 currentVertex = planetVertices[id]; //Store the current Vertex

    if(length(currentVertex - _PlanetCenter) <= _SeaLevel + 0.02) {return;} //No points in the ocean

    float3 normalizedVertexPos = normalize(planetVertices[id]) * _SeaLevel;
    float warpNoiseTex = SimpleNoise(normalizedVertexPos, _WarpOctaves, _WarpScale, _WarpPersistence, _WarpLacunarity, _WarpMultiplier, _WarpGain, _WarpOffset); //Sample warp noise
    float noiseTex = SimpleNoise(normalizedVertexPos + warpNoiseTex, _Octaves, _Scale, _Persistence, _Lacunarity, _Multiplier, _Gain, _Offset); //Sample simple noise

    float yDist = abs(planetVertices[id].y);
    float polarBlendValue = clamp(0,1,pow(abs(yDist/_PolarHeight), _PolarBlendIntensity)) * _Polar;
    if(polarBlendValue == 1){
        if(length(currentVertex - _PlanetCenter) - _SeaLevel >= _BiomePVegetationLine) {return;}
        biomePVertices.Append(planetVertices[id]);
        return;
    }
    else
    {
        float randomValue = abs(rand(planetVertices[id].xy)) / 2;

        randomValue = clamp(0, 1-polarBlendValue, randomValue);
        if(randomValue >= 1-polarBlendValue)
        {
            if(length(currentVertex - _PlanetCenter) - _SeaLevel >= _BiomePVegetationLine) {return;} //No points above vegetation line
            biomePVertices.Append(planetVertices[id]);  
            return;
        }
    }

    //Define blendValue / biome
    float blendValue = 0;
    if(noiseTex<_BiomeAEnd) { blendValue = 0; }
    else if(noiseTex>_BiomeBStart){ blendValue = 1; }
    else { 
        float difference = _BiomeBStart - _BiomeAEnd; blendValue = (noiseTex - _BiomeAEnd) / difference; 
    }
    blendValue = (_BiomeA == 1 && _BiomeB == 0) ? 0 : (_BiomeA == 0 && _BiomeB == 1) ? 1 : blendValue;
    if(_BiomeA == 0 && _BiomeB == 0) {return;}
    blendValue = (_SwapBiome == 1) ? 1 - blendValue : blendValue;
    if(blendValue == 0)
    {
        if(length(currentVertex - _PlanetCenter) - _SeaLevel >= _BiomeAVegetationLine) {return;} //No points above vegetation line
        biomeAVertices.Append(planetVertices[id]);
    }
    else if(blendValue == 1)
    {
        if(length(currentVertex - _PlanetCenter) - _SeaLevel >= _BiomeBVegetationLine) {return;} //No points above vegetation line
        biomeBVertices.Append(planetVertices[id]);
    }
    else
    {
        float randomValue = abs(rand(planetVertices[id].xy)) / 2;

        if(blendValue < 0.5)
        {
            //a biome
            randomValue = clamp(0, blendValue, randomValue);
            if(randomValue >= blendValue - 0.15)
            {
                if(length(currentVertex - _PlanetCenter) - _SeaLevel >= _BiomeAVegetationLine) {return;} //No points above vegetation line
                biomeAVertices.Append(planetVertices[id]);  
            }
        }
        else if(blendValue >= 0.5)
        {
            //b biome
            blendValue = 1 - blendValue;
            randomValue = clamp(0, blendValue, randomValue);
            if(randomValue >= blendValue - 0.15)
            {
                if(length(currentVertex - _PlanetCenter) - _SeaLevel >= _BiomeBVegetationLine) {return;} //No points above vegetation line
                biomeBVertices.Append(planetVertices[id]);  
            }
        }

    }
}
